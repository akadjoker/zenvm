// Quadtree and octree build + range query. Port of the zenpy algo_bench spatial.py.
var NPOINTS = 20000;
var NQUERIES = 2000;
var SIZE = 1024;
var CAPACITY = 8;
var MAX_DEPTH = 8;

var seed = 42;
def rnd() {
    seed = (seed * 16807) % 2147483647;
    return seed;
}

class Quad {
    var x;
    var y;
    var w;
    var depth;
    var px;
    var py;
    var count;
    var split;
    var c0;
    var c1;
    var c2;
    var c3;
    def init(x, y, w, depth) {
        self.x = x;
        self.y = y;
        self.w = w;
        self.depth = depth;
        self.px = [];
        self.py = [];
        self.count = 0;
        self.split = false;
        self.c0 = nil;
        self.c1 = nil;
        self.c2 = nil;
        self.c3 = nil;
    }
    def child_for(x, y) {
        var h = self.w div 2;
        if (y < self.y + h) {
            if (x < self.x + h) { return self.c0; }
            return self.c1;
        }
        if (x < self.x + h) { return self.c2; }
        return self.c3;
    }
    def insert(x, y) {
        var node = self;
        while (node.split) {
            node = node.child_for(x, y);
        }
        node.px.push(x);
        node.py.push(y);
        node.count = node.count + 1;
        if (node.count > CAPACITY && node.depth < MAX_DEPTH) {
            node.subdivide();
        }
    }
    def subdivide() {
        var h = self.w div 2;
        var d = self.depth + 1;
        self.c0 = Quad(self.x, self.y, h, d);
        self.c1 = Quad(self.x + h, self.y, h, d);
        self.c2 = Quad(self.x, self.y + h, h, d);
        self.c3 = Quad(self.x + h, self.y + h, h, d);
        self.split = true;
        var px = self.px;
        var py = self.py;
        for (var i = 0; i < self.count; i = i + 1) {
            self.child_for(px[i], py[i]).insert(px[i], py[i]);
        }
        self.px = [];
        self.py = [];
        self.count = 0;
    }
    def query(x0, y0, x1, y1) {
        if (x1 <= self.x || y1 <= self.y || x0 >= self.x + self.w || y0 >= self.y + self.w) {
            return 0;
        }
        if (self.split) {
            var n = self.c0.query(x0, y0, x1, y1) + self.c1.query(x0, y0, x1, y1);
            n = n + self.c2.query(x0, y0, x1, y1) + self.c3.query(x0, y0, x1, y1);
            return n;
        }
        var n = 0;
        var px = self.px;
        var py = self.py;
        for (var i = 0; i < self.count; i = i + 1) {
            if (px[i] >= x0 && px[i] < x1 && py[i] >= y0 && py[i] < y1) {
                n = n + 1;
            }
        }
        return n;
    }
}

class Oct {
    var x;
    var y;
    var z;
    var w;
    var depth;
    var px;
    var py;
    var pz;
    var count;
    var split;
    var kids;
    def init(x, y, z, w, depth) {
        self.x = x;
        self.y = y;
        self.z = z;
        self.w = w;
        self.depth = depth;
        self.px = [];
        self.py = [];
        self.pz = [];
        self.count = 0;
        self.split = false;
        self.kids = nil;
    }
    def child_for(x, y, z) {
        var h = self.w div 2;
        var i = 0;
        if (x >= self.x + h) { i = i + 1; }
        if (y >= self.y + h) { i = i + 2; }
        if (z >= self.z + h) { i = i + 4; }
        return self.kids[i];
    }
    def insert(x, y, z) {
        var node = self;
        while (node.split) {
            node = node.child_for(x, y, z);
        }
        node.px.push(x);
        node.py.push(y);
        node.pz.push(z);
        node.count = node.count + 1;
        if (node.count > CAPACITY && node.depth < MAX_DEPTH) {
            node.subdivide();
        }
    }
    def subdivide() {
        var h = self.w div 2;
        var d = self.depth + 1;
        var kids = [];
        for (var i = 0; i < 8; i = i + 1) {
            var ox = self.x;
            var oy = self.y;
            var oz = self.z;
            if (i % 2 == 1) { ox = ox + h; }
            if ((i div 2) % 2 == 1) { oy = oy + h; }
            if (i >= 4) { oz = oz + h; }
            kids.push(Oct(ox, oy, oz, h, d));
        }
        self.kids = kids;
        self.split = true;
        var px = self.px;
        var py = self.py;
        var pz = self.pz;
        for (var i = 0; i < self.count; i = i + 1) {
            self.child_for(px[i], py[i], pz[i]).insert(px[i], py[i], pz[i]);
        }
        self.px = [];
        self.py = [];
        self.pz = [];
        self.count = 0;
    }
    def query(x0, y0, z0, x1, y1, z1) {
        if (x1 <= self.x || y1 <= self.y || z1 <= self.z) { return 0; }
        if (x0 >= self.x + self.w || y0 >= self.y + self.w || z0 >= self.z + self.w) { return 0; }
        if (self.split) {
            var n = 0;
            var kids = self.kids;
            for (var i = 0; i < 8; i = i + 1) {
                n = n + kids[i].query(x0, y0, z0, x1, y1, z1);
            }
            return n;
        }
        var n = 0;
        var px = self.px;
        var py = self.py;
        var pz = self.pz;
        for (var i = 0; i < self.count; i = i + 1) {
            if (px[i] >= x0 && px[i] < x1 && py[i] >= y0 && py[i] < y1 && pz[i] >= z0 && pz[i] < z1) {
                n = n + 1;
            }
        }
        return n;
    }
}

def run_quad() {
    seed = 42;
    var q = Quad(0, 0, SIZE, 0);
    for (var i = 0; i < NPOINTS; i = i + 1) {
        q.insert(rnd() % SIZE, rnd() % SIZE);
    }
    var total = 0;
    for (var i = 0; i < NQUERIES; i = i + 1) {
        var x = rnd() % SIZE;
        var y = rnd() % SIZE;
        var w = 32 + rnd() % 64;
        total = total + q.query(x, y, x + w, y + w);
    }
    return total;
}

def run_oct() {
    seed = 42;
    var o = Oct(0, 0, 0, SIZE, 0);
    for (var i = 0; i < NPOINTS; i = i + 1) {
        o.insert(rnd() % SIZE, rnd() % SIZE, rnd() % SIZE);
    }
    var total = 0;
    for (var i = 0; i < NQUERIES; i = i + 1) {
        var x = rnd() % SIZE;
        var y = rnd() % SIZE;
        var z = rnd() % SIZE;
        var w = 64 + rnd() % 128;
        total = total + o.query(x, y, z, x + w, y + w, z + w);
    }
    return total;
}

var t0 = clock();
var a = run_quad();
var t1 = clock();
var b = run_oct();
var t2 = clock();
print("quadtree checksum", a);
print("octree checksum", b);
print("quadtree", t1 - t0);
print("octree", t2 - t1);
