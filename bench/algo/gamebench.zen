// Game-shaped workloads: SAT polygon collision with per-frame transforms,
// broadphase over 1000 bodies, and an ECS-style sprite update.
// Port of the zenpy algo_bench gamebench.py.
//
// These stress what a game does every frame — float math, field access on
// many small objects, array iteration, method calls — rather than the
// recursive/integer shapes the other benchmarks cover.

var NBODIES = 1000;
var NFRAMES = 60;
var NSPRITES = 4000;
var WORLD = 2048;

var seed = 42;
def rnd() {
    seed = (seed * 16807) % 2147483647;
    return seed;
}

def make_poly(n, radius) {
    var pts = [];
    var i = 0;
    while (i < n) {
        var a = 6.28318530718 * i / n;
        var c = 1.0;
        var s = a;
        var a2 = a * a;
        var term_c = 1.0;
        var term_s = a;
        var k = 1;
        while (k <= 5) {
            term_c = -term_c * a2 / ((2 * k - 1) * (2 * k));
            c = c + term_c;
            term_s = -term_s * a2 / ((2 * k) * (2 * k + 1));
            s = s + term_s;
            k = k + 1;
        }
        pts.push([c * radius, s * radius]);
        i = i + 1;
    }
    return pts;
}

class Body {
    var px; var py; var angle; var vx; var vy; var spin;
    var poly; var wx; var wy;
    var minx; var miny; var maxx; var maxy;

    def init(px, py, angle, vx, vy, spin, poly) {
        self.px = px; self.py = py; self.angle = angle;
        self.vx = vx; self.vy = vy; self.spin = spin;
        self.poly = poly;
        self.wx = []; self.wy = [];
        self.minx = 0.0; self.miny = 0.0; self.maxx = 0.0; self.maxy = 0.0;
        var i = 0;
        while (i < len(poly)) {
            self.wx.push(0.0);
            self.wy.push(0.0);
            i = i + 1;
        }
    }

    def integrate(dt) {
        self.px = self.px + self.vx * dt;
        self.py = self.py + self.vy * dt;
        self.angle = self.angle + self.spin * dt;
        if (self.px < 0.0) { self.px = self.px + WORLD; }
        if (self.px > WORLD) { self.px = self.px - WORLD; }
        if (self.py < 0.0) { self.py = self.py + WORLD; }
        if (self.py > WORLD) { self.py = self.py - WORLD; }
    }

    def transform() {
        var a = self.angle;
        while (a > 3.14159265359) { a = a - 6.28318530718; }
        while (a < -3.14159265359) { a = a + 6.28318530718; }
        var a2 = a * a;
        var c = 1.0;
        var s = a;
        var term_c = 1.0;
        var term_s = a;
        var k = 1;
        while (k <= 5) {
            term_c = -term_c * a2 / ((2 * k - 1) * (2 * k));
            c = c + term_c;
            term_s = -term_s * a2 / ((2 * k) * (2 * k + 1));
            s = s + term_s;
            k = k + 1;
        }
        var n = len(self.poly);
        var minx = 1000000.0;
        var miny = 1000000.0;
        var maxx = -1000000.0;
        var maxy = -1000000.0;
        var i = 0;
        while (i < n) {
            var p = self.poly[i];
            var x = p[0] * c - p[1] * s + self.px;
            var y = p[0] * s + p[1] * c + self.py;
            self.wx[i] = x;
            self.wy[i] = y;
            if (x < minx) { minx = x; }
            if (x > maxx) { maxx = x; }
            if (y < miny) { miny = y; }
            if (y > maxy) { maxy = y; }
            i = i + 1;
        }
        self.minx = minx; self.miny = miny;
        self.maxx = maxx; self.maxy = maxy;
    }
}

var proj_lo = 0.0;
var proj_hi = 0.0;
def project(wx, wy, n, ax, ay) {
    var lo = wx[0] * ax + wy[0] * ay;
    var hi = lo;
    var i = 1;
    while (i < n) {
        var d = wx[i] * ax + wy[i] * ay;
        if (d < lo) { lo = d; }
        if (d > hi) { hi = d; }
        i = i + 1;
    }
    proj_lo = lo;
    proj_hi = hi;
    return 0;
}

def sat_overlap(a, b) {
    var na = len(a.wx);
    var nb = len(b.wx);
    var i = 0;
    while (i < na) {
        var j = i + 1;
        if (j == na) { j = 0; }
        var ex = a.wx[j] - a.wx[i];
        var ey = a.wy[j] - a.wy[i];
        var ax = -ey;
        var ay = ex;
        project(a.wx, a.wy, na, ax, ay);
        var alo = proj_lo; var ahi = proj_hi;
        project(b.wx, b.wy, nb, ax, ay);
        var blo = proj_lo; var bhi = proj_hi;
        if (ahi < blo || bhi < alo) { return false; }
        i = i + 1;
    }
    i = 0;
    while (i < nb) {
        var j = i + 1;
        if (j == nb) { j = 0; }
        var ex = b.wx[j] - b.wx[i];
        var ey = b.wy[j] - b.wy[i];
        var ax = -ey;
        var ay = ex;
        project(a.wx, a.wy, na, ax, ay);
        var alo = proj_lo; var ahi = proj_hi;
        project(b.wx, b.wy, nb, ax, ay);
        var blo = proj_lo; var bhi = proj_hi;
        if (ahi < blo || bhi < alo) { return false; }
        i = i + 1;
    }
    return true;
}

def key_minx(b) {
    return b.minx;
}

def run_physics() {
    var shapes = [make_poly(3, 12.0), make_poly(4, 14.0), make_poly(5, 11.0),
                  make_poly(6, 13.0), make_poly(8, 10.0)];
    var bodies = [];
    var i = 0;
    while (i < NBODIES) {
        var px = float(rnd() % WORLD);
        var py = float(rnd() % WORLD);
        var ang = float(rnd() % 628) / 100.0;
        var vx = float(rnd() % 200 - 100) / 2.0;
        var vy = float(rnd() % 200 - 100) / 2.0;
        var spin = float(rnd() % 200 - 100) / 100.0;
        bodies.push(Body(px, py, ang, vx, vy, spin, shapes[rnd() % 5]));
        i = i + 1;
    }

    var hits = 0;
    var fr = 0;
    var dt = 0.016;
    var order = [];
    i = 0;
    while (i < NBODIES) { order.push(bodies[i]); i = i + 1; }

    while (fr < NFRAMES) {
        i = 0;
        while (i < NBODIES) {
            var b = bodies[i];
            b.integrate(dt);
            b.transform();
            i = i + 1;
        }

        order.sort(key_minx);

        i = 0;
        while (i < NBODIES) {
            var a = order[i];
            var amaxx = a.maxx;
            var j = i + 1;
            while (j < NBODIES) {
                var b2 = order[j];
                if (b2.minx > amaxx) {
                    j = NBODIES;
                } else {
                    if (a.miny <= b2.maxy && b2.miny <= a.maxy) {
                        if (sat_overlap(a, b2)) { hits = hits + 1; }
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        fr = fr + 1;
    }
    return hits;
}

class World {
    var px; var py; var vx; var vy; var life; var frame_idx; var alive; var count;

    def init() {
        self.px = []; self.py = []; self.vx = []; self.vy = [];
        self.life = []; self.frame_idx = []; self.alive = [];
        self.count = 0;
    }

    def add(px, py, vx, vy, life) {
        self.px.push(px);
        self.py.push(py);
        self.vx.push(vx);
        self.vy.push(vy);
        self.life.push(life);
        self.frame_idx.push(0);
        self.alive.push(1);
        self.count = self.count + 1;
    }

    def system_move(dt) {
        var i = 0;
        var n = self.count;
        while (i < n) {
            if (self.alive[i] == 1) {
                self.px[i] = self.px[i] + self.vx[i] * dt;
                self.py[i] = self.py[i] + self.vy[i] * dt;
                if (self.px[i] < 0.0 || self.px[i] > WORLD) { self.vx[i] = -self.vx[i]; }
                if (self.py[i] < 0.0 || self.py[i] > WORLD) { self.vy[i] = -self.vy[i]; }
            }
            i = i + 1;
        }
    }

    def system_animate() {
        var i = 0;
        var n = self.count;
        var acc = 0;
        while (i < n) {
            if (self.alive[i] == 1) {
                var f = self.frame_idx[i] + 1;
                if (f >= 8) { f = 0; }
                self.frame_idx[i] = f;
                acc = acc + f;
            }
            i = i + 1;
        }
        return acc;
    }

    def system_lifetime() {
        var i = 0;
        var n = self.count;
        var killed = 0;
        while (i < n) {
            if (self.alive[i] == 1) {
                var l = self.life[i] - 1;
                self.life[i] = l;
                if (l <= 0) {
                    self.alive[i] = 0;
                    killed = killed + 1;
                }
            }
            i = i + 1;
        }
        return killed;
    }
}

def run_ecs() {
    var w = World();
    var i = 0;
    while (i < NSPRITES) {
        w.add(float(rnd() % WORLD), float(rnd() % WORLD),
                float(rnd() % 100 - 50), float(rnd() % 100 - 50),
                20 + rnd() % 40);
        i = i + 1;
    }

    var total = 0;
    var fr = 0;
    while (fr < NFRAMES) {
        w.system_move(0.016);
        total = total + w.system_animate();
        total = total + w.system_lifetime();
        if (fr % 10 == 0) {
            var k = 0;
            while (k < 200) {
                w.add(float(rnd() % WORLD), float(rnd() % WORLD),
                        float(rnd() % 100 - 50), float(rnd() % 100 - 50),
                        20 + rnd() % 40);
                k = k + 1;
            }
        }
        fr = fr + 1;
    }
    return total;
}

var t0 = clock();
var a = run_physics();
var t1 = clock();
var b = run_ecs();
var t2 = clock();
print("physics checksum", a);
print("ecs checksum", b);
print("physics", t1 - t0);
print("ecs", t2 - t1);
