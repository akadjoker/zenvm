// ============================================================
// pico_lite — a tiny 128x128 indexed software framebuffer.
// Pure Zen, no display dependency: drawing writes into a byte
// buffer; a host (e.g. raylib) can blit fb to the screen.
// Doubles as a self-checking test (run: zen examples/pico_lite.zen).
// ============================================================

var W = 128;
var H = 128;

class Screen {
    var fb;
    def init() { self.fb = Uint8Array(W * H); }

    def cls(c) { self.fb.fill(c); }
    def inb(x, y) { return x >= 0 and x < W and y >= 0 and y < H; }
    def pset(x, y, c) { if (self.inb(x, y)) { self.fb[y * W + x] = c; } }
    def pget(x, y) { if (self.inb(x, y)) { return self.fb[y * W + x]; } return 0; }

    def hline(x0, x1, y, c) { foreach (x in x0..x1 + 1) { self.pset(x, y, c); } }
    def vline(x, y0, y1, c) { foreach (y in y0..y1 + 1) { self.pset(x, y, c); } }

    def rectfill(x0, y0, x1, y1, c) {
        foreach (y in y0..y1 + 1) { self.hline(x0, x1, y, c); }
    }
    def rect(x0, y0, x1, y1, c) {
        self.hline(x0, x1, y0, c); self.hline(x0, x1, y1, c);
        self.vline(x0, y0, y1, c); self.vline(x1, y0, y1, c);
    }

    def line(x0, y0, x1, y1, c) {
        var dx = abs(x1 - x0); var dy = -abs(y1 - y0);
        var sx = x0 < x1 ? 1 : -1; var sy = y0 < y1 ? 1 : -1;
        var err = dx + dy;
        loop {
            self.pset(x0, y0, c);
            if (x0 == x1 and y0 == y1) { break; }
            var e2 = 2 * err;
            if (e2 >= dy) { err += dy; x0 += sx; }
            if (e2 <= dx) { err += dx; y0 += sy; }
        }
    }

    // Midpoint circle outline.
    def circ(cx, cy, r, c) {
        var x = r; var y = 0; var err = 1 - r;
        loop {
            if (x < y) { break; }
            self.pset(cx + x, cy + y, c); self.pset(cx + y, cy + x, c);
            self.pset(cx - x, cy + y, c); self.pset(cx - y, cy + x, c);
            self.pset(cx - x, cy - y, c); self.pset(cx - y, cy - x, c);
            self.pset(cx + x, cy - y, c); self.pset(cx + y, cy - x, c);
            y += 1;
            if (err < 0) { err += 2 * y + 1; }
            else { x -= 1; err += 2 * (y - x) + 1; }
        }
    }

    def count(c) {
        var n = 0;
        foreach (i in 0..W * H) { if (self.fb[i] == c) { n += 1; } }
        return n;
    }
}

// ---- self-test ----
def eq(a, b, m) { if (a == b) { print("PASS " + m); } else { print("FAIL " + m + " got=" + a + " want=" + b); } }

var s = Screen();
s.cls(0);           eq(s.count(0), W * H, "cls");
s.pset(10, 20, 7);  eq(s.pget(10, 20), 7, "pset/pget");
s.pset(-1, 0, 9);   eq(s.pget(-1, 0), 0, "clip");
s.cls(0); s.rectfill(0, 0, 9, 9, 3);  eq(s.count(3), 100, "rectfill");
s.cls(0); s.rect(0, 0, 9, 9, 5);      eq(s.count(5), 36, "rect outline (4*10-4)");
s.cls(0); s.line(0, 0, 9, 0, 6);      eq(s.count(6), 10, "hline via line");
s.cls(0); s.circ(20, 20, 5, 8);       eq(s.pget(25, 20), 8, "circ east point");
print("=== pico_lite OK ===");
