// ============================================================
// chip8 — a CHIP-8 CPU core written in Zen.
// Memory/registers/stack + fetch-decode-dispatch over the core
// opcode set. 64x32 XOR display buffer. Self-checking headless
// (input/sound left for a later pass). A "VM inside the VM".
// ============================================================

var MEM_SIZE = 4096;
var PROG_START = 512;   // 0x200
var FONT_ADDR = 80;     // 0x50 — standard font location
var SCR_W = 64;
var SCR_H = 32;

// 16 hex digits, 5 bytes (rows) each — the built-in CHIP-8 font.
var FONT = [
    0xF0,0x90,0x90,0x90,0xF0, 0x20,0x60,0x20,0x20,0x70, 0xF0,0x10,0xF0,0x80,0xF0, 0xF0,0x10,0xF0,0x10,0xF0,
    0x90,0x90,0xF0,0x10,0x10, 0xF0,0x80,0xF0,0x10,0xF0, 0xF0,0x80,0xF0,0x90,0xF0, 0xF0,0x10,0x20,0x40,0x40,
    0xF0,0x90,0xF0,0x90,0xF0, 0xF0,0x90,0xF0,0x10,0xF0, 0xF0,0x90,0xF0,0x90,0x90, 0xE0,0x90,0xE0,0x90,0xE0,
    0xF0,0x80,0x80,0x80,0xF0, 0xE0,0x90,0x90,0x90,0xE0, 0xF0,0x80,0xF0,0x80,0xF0, 0xF0,0x80,0xF0,0x80,0x80
];

class Chip8 {
    var mem;      // Uint8Array(4096) — 8-bit, auto-wraps on write
    var v;        // Uint8Array(16)   — V0..VF
    var i;        // index register (12-bit)
    var pc;       // program counter
    var stack;    // call stack (array of return addrs)
    var dt;       // delay timer
    var st;       // sound timer
    var scr;      // Uint8Array(64*32) — 0/1 pixels
    var keys;     // Uint8Array(16) — 0/1 pressed
    var seed;     // RNG state

    def init() {
        self.mem = Uint8Array(MEM_SIZE);
        self.v = Uint8Array(16);
        self.i = 0;
        self.pc = PROG_START;
        self.stack = [];
        self.dt = 0;
        self.st = 0;
        self.scr = Uint8Array(SCR_W * SCR_H);
        self.keys = Uint8Array(16);
        self.seed = 0x1234;
        for (var k = 0; k < FONT.len(); k += 1) { self.mem[FONT_ADDR + k] = FONT[k]; }
    }

    def rand() { self.seed = (self.seed * 1103515245 + 12345) % 2147483648; return (self.seed >> 16) & 0xFF; }
    def tick_timers() { if (self.dt > 0) { self.dt -= 1; } if (self.st > 0) { self.st -= 1; } }

    def load(bytes) {
        for (var k = 0; k < bytes.len(); k += 1) { self.mem[PROG_START + k] = bytes[k]; }
    }

    def cls() { self.scr.fill(0); }

    // Draw N-byte sprite at (vx,vy); XOR into screen; VF = collision.
    def draw(vx, vy, n) {
        self.v[15] = 0;
        for (var row = 0; row < n; row += 1) {
            var sprite = self.mem[self.i + row];
            for (var col = 0; col < 8; col += 1) {
                if ((sprite & (128 >> col)) != 0) {
                    var px = (vx + col) % SCR_W;
                    var py = (vy + row) % SCR_H;
                    var idx = py * SCR_W + px;
                    if (self.scr[idx] == 1) { self.v[15] = 1; }   // collision
                    self.scr[idx] = self.scr[idx] ^ 1;
                }
            }
        }
    }

    // Execute one instruction.
    def step() {
        var op = (self.mem[self.pc] << 8) | self.mem[self.pc + 1];
        self.pc += 2;

        var nnn = op & 0x0FFF;
        var nn = op & 0x00FF;
        var n = op & 0x000F;
        var x = (op >> 8) & 0x0F;
        var y = (op >> 4) & 0x0F;
        var hi = (op >> 12) & 0x0F;

        if (op == 0x00E0) { self.cls(); return; }
        if (op == 0x00EE) { self.pc = self.stack.pop(); return; }

        switch (hi) {
            case 0x1: { self.pc = nnn; return; }                       // JP addr
            case 0x2: { self.stack.push(self.pc); self.pc = nnn; return; } // CALL
            case 0x3: { if (self.v[x] == nn) { self.pc += 2; } return; }   // SE Vx,byte
            case 0x4: { if (self.v[x] != nn) { self.pc += 2; } return; }   // SNE Vx,byte
            case 0x5: { if (self.v[x] == self.v[y]) { self.pc += 2; } return; } // SE Vx,Vy
            case 0x6: { self.v[x] = nn; return; }                      // LD Vx,byte
            case 0x7: { self.v[x] = self.v[x] + nn; return; }          // ADD Vx,byte (wraps)
            case 0x9: { if (self.v[x] != self.v[y]) { self.pc += 2; } return; } // SNE Vx,Vy
            case 0xA: { self.i = nnn; return; }                        // LD I,addr
            case 0xB: { self.pc = nnn + self.v[0]; return; }           // JP V0,addr
            case 0xC: { self.v[x] = self.rand() & nn; return; }        // RND Vx,byte
            case 0xD: { self.draw(self.v[x], self.v[y], n); return; }  // DRW
        }

        if (hi == 0xE) {
            if (nn == 0x9E) { if (self.keys[self.v[x]] == 1) { self.pc += 2; } return; }   // SKP
            if (nn == 0xA1) { if (self.keys[self.v[x]] == 0) { self.pc += 2; } return; }   // SKNP
        }

        if (hi == 0x8) {
            switch (n) {
                case 0x0: { self.v[x] = self.v[y]; return; }
                case 0x1: { self.v[x] = self.v[x] | self.v[y]; return; }
                case 0x2: { self.v[x] = self.v[x] & self.v[y]; return; }
                case 0x3: { self.v[x] = self.v[x] ^ self.v[y]; return; }
                case 0x4: {                                            // ADD with carry
                    var sum = self.v[x] + self.v[y];
                    self.v[15] = sum > 255 ? 1 : 0;
                    self.v[x] = sum;
                    return;
                }
                case 0x5: {                                            // SUB (VF = NOT borrow)
                    var a = self.v[x]; var b = self.v[y];
                    self.v[15] = a >= b ? 1 : 0;
                    self.v[x] = a - b;
                    return;
                }
                case 0x6: {                                            // SHR
                    self.v[15] = self.v[x] & 1;
                    self.v[x] = self.v[x] >> 1;
                    return;
                }
                case 0x7: {                                            // SUBN
                    var a = self.v[x]; var b = self.v[y];
                    self.v[15] = b >= a ? 1 : 0;
                    self.v[x] = b - a;
                    return;
                }
                case 0xE: {                                            // SHL
                    self.v[15] = (self.v[x] >> 7) & 1;
                    self.v[x] = self.v[x] << 1;
                    return;
                }
            }
        }

        if (hi == 0xF) {
            switch (nn) {
                case 0x07: { self.v[x] = self.dt; return; }
                case 0x0A: {                                           // wait for key press
                    var pressed = -1;
                    for (var kk = 0; kk < 16; kk += 1) { if (self.keys[kk] == 1) { pressed = kk; } }
                    if (pressed < 0) { self.pc -= 2; }                 // no key: re-run this op
                    else { self.v[x] = pressed; }
                    return;
                }
                case 0x15: { self.dt = self.v[x]; return; }
                case 0x18: { self.st = self.v[x]; return; }
                case 0x1E: { self.i = self.i + self.v[x]; return; }
                case 0x29: { self.i = FONT_ADDR + self.v[x] * 5; return; }   // font sprite addr
                case 0x33: {                                           // BCD
                    var val = self.v[x];
                    self.mem[self.i]     = val div 100;
                    self.mem[self.i + 1] = (val div 10) % 10;
                    self.mem[self.i + 2] = val % 10;
                    return;
                }
                case 0x55: { for (var k = 0; k <= x; k += 1) { self.mem[self.i + k] = self.v[k]; } return; }
                case 0x65: { for (var k = 0; k <= x; k += 1) { self.v[k] = self.mem[self.i + k]; } return; }
            }
        }
        // unknown opcode: ignore (no crash)
    }

    def run(steps) { for (var s = 0; s < steps; s += 1) { self.step(); } }
    def scr_count() { var c = 0; for (var k = 0; k < SCR_W * SCR_H; k += 1) { if (self.scr[k] == 1) { c += 1; } } return c; }
}

def eq(a, b, m) { if (a == b) { print("PASS " + m); } else { print("FAIL " + m + " got=" + a + " want=" + b); } }

// Hand-assembled ROM exercising the core opcodes.
var c = Chip8();
c.load([
    0x6A, 0x05,   // 200: LD VA, 5
    0x6B, 0x03,   // 202: LD VB, 3
    0x8A, 0xB4,   // 204: ADD VA, VB   -> VA=8, VF=0
    0x7A, 0x02,   // 206: ADD VA, 2    -> VA=10
    0x8A, 0xB5,   // 208: SUB VA, VB   -> VA=7, VF=1 (10>=3)
    0x6C, 0xFF,   // 20A: LD VC, 255
    0x7C, 0x02,   // 20C: ADD VC, 2    -> VC wraps to 1
    0x12, 0x0E    // 20E: JP 0x20E     (halt: jump to self)
]);
c.run(7);
eq(c.v[10], 7, "VA = (5+3)-3 = 7");     // wait: 5+3=8, 8-3=5? let's check below
eq(c.v[15], 1, "VF = 1 (no borrow)");
eq(c.v[12], 1, "VC wrapped 255+2 -> 1");

// --- font + DRW: draw digit '0', XOR cancel, collision ---
var c2 = Chip8();
c2.v[5] = 0; c2.v[6] = 0; c2.v[7] = 0;
c2.load([0xF5, 0x29, 0xD6, 0x75, 0x12, 0x04]);   // LD F,V5 ; DRW V6,V7,5 ; JP self
c2.run(2);
eq(c2.scr_count(), 14, "font '0' drawn (14 px)");   // F0 90 90 90 F0 = 4+2+2+2+4
eq(c2.v[15], 0, "no collision on first draw");
c2.pc = PROG_START; c2.run(2);                    // draw again same spot
eq(c2.scr_count(), 0, "XOR redraw cancels");
eq(c2.v[15], 1, "collision flag set on overlap");

// --- BCD (FX33) ---
var c3 = Chip8();
c3.v[0] = 173;
c3.load([0xA3, 0x00, 0x60, 0xAD, 0xF0, 0x33]);   // LD I,0x300 ; LD V0,173 ; LD B,V0
c3.run(3);
eq(c3.mem[0x300], 1, "BCD hundreds=1"); eq(c3.mem[0x301], 7, "BCD tens=7"); eq(c3.mem[0x302], 3, "BCD ones=3");

// --- store/load V0..Vx (FX55/FX65) ---
var c4 = Chip8();
c4.v[0] = 11; c4.v[1] = 22; c4.v[2] = 33;
c4.load([0xA4, 0x00, 0xF2, 0x55]);               // LD I,0x400 ; LD [I],V2
c4.run(2);
eq(c4.mem[0x400], 11, "store V0"); eq(c4.mem[0x402], 33, "store V2");
c4.v[0] = 0; c4.v[1] = 0; c4.v[2] = 0;
c4.pc = PROG_START; c4.load([0xA4, 0x00, 0xF2, 0x65]); c4.pc = PROG_START;
c4.run(2);
eq(c4.v[1], 22, "load back V1");

// --- RND is masked ---
var c5 = Chip8();
c5.load([0xC0, 0x0F]);                            // RND V0, 0x0F
c5.run(1);
var rv = c5.v[0]; eq(rv <= 15 and rv >= 0, true, "RND masked to 0x0F");

print("=== chip8 core OK ===");
