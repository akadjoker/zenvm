// ============================================================
// pascal / interpreter — a tree-walking evaluator Visitor.
// node.accept(interp) -> interp.visit_X(node). Expressions return
// a value; statements return nil and mutate `env`. Output from
// write/writeln is both printed and captured in `self.output`
// (so tests can assert on it). Heavy recursion + mutable state +
// polymorphic dispatch = a strong VM workout.
// ============================================================
include "parser.zen";

class Interpreter {
    var env;        // map: variable name (lowercased) -> value
    var output;     // captured program output

    def init() { self.env = {}; self.output = ""; }

    // ---- helpers ----
    def get(name) {
        var k = name.lower();
        if (k in self.env) { return self.env[k]; }
        return 0;                       // undeclared -> 0 (permissive)
    }
    def set(name, val) { self.env[name.lower()] = val; }
    def emit(s) { self.output = self.output + s; }

    // ---- expression visitors (return a value) ----
    def visit_num(n) { if (n.is_real) { return float(n.text); } return int(n.text); }
    def visit_str(n) { return n.value; }
    def visit_bool(n) { return n.value; }
    def visit_varref(n) { return self.get(n.name); }

    def visit_binop(n) {
        var l = n.left.accept(self);
        var r = n.right.accept(self);
        var op = n.op;
        if (op == "PLUS")   { return l + r; }
        if (op == "MINUS")  { return l - r; }
        if (op == "STAR")   { return l * r; }
        if (op == "SLASH")  { return l / r; }        // real division
        if (op == "KW_DIV") { return l div r; }      // integer division
        if (op == "KW_MOD") { return l % r; }
        if (op == "EQ")     { return l == r; }
        if (op == "NEQ")    { return l != r; }
        if (op == "LT")     { return l < r; }
        if (op == "LE")     { return l <= r; }
        if (op == "GT")     { return l > r; }
        if (op == "GE")     { return l >= r; }
        if (op == "KW_AND") { return l and r; }
        if (op == "KW_OR")  { return l or r; }
        return nil;
    }
    def visit_unary(n) {
        var v = n.operand.accept(self);
        if (n.op == "MINUS")  { return -v; }
        if (n.op == "KW_NOT") { return v == false; }
        return v;                                     // unary '+'
    }
    def visit_call(n) {
        var name = n.name.lower();
        if (name == "write" or name == "writeln") {
            var s = "";
            foreach (a in n.args) { s = s + str(a.accept(self)); }
            self.emit(s);
            if (name == "writeln") { self.emit(chr(10)); }
            return nil;
        }
        if (name == "read" or name == "readln") { return nil; }   // no stdin here
        // unknown call: evaluate args for side effects, yield 0
        foreach (a in n.args) { a.accept(self); }
        return 0;
    }

    // ---- statement visitors (return nil) ----
    def visit_assign(n) { self.set(n.name, n.expr.accept(self)); return nil; }
    def visit_exprstmt(n) { n.call.accept(self); return nil; }

    def visit_if(n) {
        if (self.truthy(n.cond.accept(self))) { n.then_s.accept(self); }
        else if (n.else_s != nil) { n.else_s.accept(self); }
        return nil;
    }
    def visit_while(n) {
        while (self.truthy(n.cond.accept(self))) { n.body.accept(self); }
        return nil;
    }
    def visit_for(n) {
        var i = n.start.accept(self);
        var stop = n.stop.accept(self);
        if (n.downto) {
            while (i >= stop) { self.set(n.var_name, i); n.body.accept(self); i = self.get(n.var_name) - 1; }
        } else {
            while (i <= stop) { self.set(n.var_name, i); n.body.accept(self); i = self.get(n.var_name) + 1; }
        }
        return nil;
    }
    def visit_repeat(n) {
        var go = true;
        while (go) {
            foreach (s in n.body) { s.accept(self); }
            go = self.truthy(n.cond.accept(self)) == false;   // until cond
        }
        return nil;
    }
    def visit_compound(n) { foreach (s in n.stmts) { s.accept(self); } return nil; }

    // ---- declarations / program ----
    def visit_vardecl(n) {
        var dflt = 0;
        var t = n.type_name.lower();
        if (t == "real") { dflt = 0.0; }
        else if (t == "boolean") { dflt = false; }
        else if (t == "string" or t == "char") { dflt = ""; }
        foreach (nm in n.names) { self.set(nm, dflt); }
        return nil;
    }
    def visit_block(n) {
        foreach (d in n.decls) { d.accept(self); }
        n.compound.accept(self);
        return nil;
    }
    def visit_program(n) { n.block.accept(self); return nil; }

    def truthy(v) { if (v == nil or v == false) { return false; } return true; }

    // ---- entry point ----
    def run(src) {
        var p = Parser(src);
        var ast = p.parse_program();
        if (p.had_error) { self.emit("PARSE ERROR: " + p.err_msg); return self.output; }
        ast.accept(self);
        return self.output;
    }
}

def interpret(src) { return Interpreter().run(src); }
