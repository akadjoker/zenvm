// ============================================================
// pascal / ast — AST node classes for the Pascal subset.
// Every node implements accept(v), which dispatches to the
// matching visit_* on the visitor (the classic Visitor pattern
// via double dispatch). This is deliberately method-call heavy
// to stress the VM's polymorphic dispatch.
// ============================================================

class Node { def accept(v) { return nil; } }   // base

// ---------- expressions ----------
class NumLit : Node {
    var text; var is_real;
    def init(text, is_real) { self.text = text; self.is_real = is_real; }
    def accept(v) { return v.visit_num(self); }
}
class StrLit : Node {
    var value;
    def init(value) { self.value = value; }
    def accept(v) { return v.visit_str(self); }
}
class BoolLit : Node {
    var value;                     // true / false
    def init(value) { self.value = value; }
    def accept(v) { return v.visit_bool(self); }
}
class VarRef : Node {
    var name;
    def init(name) { self.name = name; }
    def accept(v) { return v.visit_varref(self); }
}
class BinOp : Node {
    var left; var op; var right;   // op is a token kind string, e.g. "PLUS"
    def init(left, op, right) { self.left = left; self.op = op; self.right = right; }
    def accept(v) { return v.visit_binop(self); }
}
class UnaryOp : Node {
    var op; var operand;
    def init(op, operand) { self.op = op; self.operand = operand; }
    def accept(v) { return v.visit_unary(self); }
}
class Call : Node {                 // f(args)  — also used for writeln/write
    var name; var args;            // args: array of expression nodes
    def init(name, args) { self.name = name; self.args = args; }
    def accept(v) { return v.visit_call(self); }
}

// ---------- statements ----------
class Assign : Node {
    var name; var expr;
    def init(name, expr) { self.name = name; self.expr = expr; }
    def accept(v) { return v.visit_assign(self); }
}
class If : Node {
    var cond; var then_s; var else_s;   // else_s may be nil
    def init(cond, then_s, else_s) { self.cond = cond; self.then_s = then_s; self.else_s = else_s; }
    def accept(v) { return v.visit_if(self); }
}
class While : Node {
    var cond; var body;
    def init(cond, body) { self.cond = cond; self.body = body; }
    def accept(v) { return v.visit_while(self); }
}
class For : Node {
    var var_name; var start; var stop; var downto; var body;
    def init(var_name, start, stop, downto, body) {
        self.var_name = var_name; self.start = start; self.stop = stop;
        self.downto = downto; self.body = body;
    }
    def accept(v) { return v.visit_for(self); }
}
class Repeat : Node {
    var body; var cond;            // body: array of statements; run until cond
    def init(body, cond) { self.body = body; self.cond = cond; }
    def accept(v) { return v.visit_repeat(self); }
}
class Compound : Node {            // begin ... end
    var stmts;                     // array of statement nodes
    def init(stmts) { self.stmts = stmts; }
    def accept(v) { return v.visit_compound(self); }
}
class ExprStmt : Node {           // a bare procedure call used as a statement
    var call;
    def init(call) { self.call = call; }
    def accept(v) { return v.visit_exprstmt(self); }
}

// ---------- declarations / program ----------
class VarDecl : Node {
    var names; var type_name;       // names: array of identifiers
    def init(names, type_name) { self.names = names; self.type_name = type_name; }
    def accept(v) { return v.visit_vardecl(self); }
}
class Block : Node {
    var decls; var compound;        // decls: array of VarDecl; compound: Compound
    def init(decls, compound) { self.decls = decls; self.compound = compound; }
    def accept(v) { return v.visit_block(self); }
}
class Program : Node {
    var name; var block;
    def init(name, block) { self.name = name; self.block = block; }
    def accept(v) { return v.visit_program(self); }
}
