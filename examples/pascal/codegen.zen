// ============================================================
// pascal / codegen — a Visitor that lowers the AST to bytecode
// for a small stack machine (see stackvm.zen). Every instruction
// is an Instr(op, a, b); jumps are back-patched. This is the third
// Visitor over the same AST (print / interpret / compile).
// ============================================================
include "parser.zen";

class Instr {
    var op;   // string opcode
    var a;    // primary operand (const value, var name, jump target, native name)
    var b;    // secondary (native argc)
    def init(op, a, b) { self.op = op; self.a = a; self.b = b; }
    def __str__() { return self.op + " " + str(self.a) + " " + str(self.b); }
}

class CodeGen {
    var code;     // array of Instr
    var tmp;      // counter for hidden temporaries (for-loop limits)

    def init() { self.code = []; self.tmp = 0; }

    def emit(op, a, b) { self.code.push(Instr(op, a, b)); return self.code.len() - 1; }
    def here() { return self.code.len(); }
    def patch(idx, target) { self.code[idx].a = target; }

    // ---- expressions (leave one value on the stack) ----
    def visit_num(n)  { if (n.is_real) { self.emit("PUSH", float(n.text), 0); } else { self.emit("PUSH", int(n.text), 0); } return nil; }
    def visit_str(n)  { self.emit("PUSH", n.value, 0); return nil; }
    def visit_bool(n) { self.emit("PUSH", n.value, 0); return nil; }
    def visit_varref(n) { self.emit("LOAD", n.name.lower(), 0); return nil; }

    def visit_binop(n) {
        n.left.accept(self);
        n.right.accept(self);
        var m = {
            "PLUS": "ADD", "MINUS": "SUB", "STAR": "MUL", "SLASH": "DIV",
            "KW_DIV": "IDIV", "KW_MOD": "MOD",
            "EQ": "EQ", "NEQ": "NEQ", "LT": "LT", "LE": "LE", "GT": "GT", "GE": "GE",
            "KW_AND": "AND", "KW_OR": "OR"
        };
        self.emit(m[n.op], 0, 0);
        return nil;
    }
    def visit_unary(n) {
        n.operand.accept(self);
        if (n.op == "MINUS") { self.emit("NEG", 0, 0); }
        else if (n.op == "KW_NOT") { self.emit("NOT", 0, 0); }
        return nil;
    }
    def visit_call(n) {                         // leaves one value (nil for procedures)
        foreach (a in n.args) { a.accept(self); }
        self.emit("CALLN", n.name.lower(), n.args.len());
        return nil;
    }

    // ---- statements ----
    def visit_assign(n) { n.expr.accept(self); self.emit("STORE", n.name.lower(), 0); return nil; }
    def visit_exprstmt(n) { n.call.accept(self); self.emit("POP", 0, 0); return nil; }   // discard proc result

    def visit_if(n) {
        n.cond.accept(self);
        var jf = self.emit("JMPF", -1, 0);
        n.then_s.accept(self);
        if (n.else_s != nil) {
            var jend = self.emit("JMP", -1, 0);
            self.patch(jf, self.here());
            n.else_s.accept(self);
            self.patch(jend, self.here());
        } else {
            self.patch(jf, self.here());
        }
        return nil;
    }
    def visit_while(n) {
        var top = self.here();
        n.cond.accept(self);
        var jf = self.emit("JMPF", -1, 0);
        n.body.accept(self);
        self.emit("JMP", top, 0);
        self.patch(jf, self.here());
        return nil;
    }
    def visit_for(n) {
        var endslot = "$end" + str(self.tmp); self.tmp += 1;
        var v = n.var_name.lower();
        n.start.accept(self); self.emit("STORE", v, 0);
        n.stop.accept(self);  self.emit("STORE", endslot, 0);   // limit evaluated once
        var top = self.here();
        self.emit("LOAD", v, 0);
        self.emit("LOAD", endslot, 0);
        if (n.downto) { self.emit("GE", 0, 0); } else { self.emit("LE", 0, 0); }
        var jf = self.emit("JMPF", -1, 0);
        n.body.accept(self);
        self.emit("LOAD", v, 0); self.emit("PUSH", 1, 0);
        if (n.downto) { self.emit("SUB", 0, 0); } else { self.emit("ADD", 0, 0); }
        self.emit("STORE", v, 0);
        self.emit("JMP", top, 0);
        self.patch(jf, self.here());
        return nil;
    }
    def visit_repeat(n) {
        var top = self.here();
        foreach (s in n.body) { s.accept(self); }
        n.cond.accept(self);
        self.emit("JMPF", top, 0);        // until cond: loop back while cond is false
        return nil;
    }
    def visit_compound(n) { foreach (s in n.stmts) { s.accept(self); } return nil; }

    def visit_vardecl(n) {
        var t = n.type_name.lower();
        var dflt = 0;
        if (t == "real") { dflt = 0.0; } else if (t == "boolean") { dflt = false; }
        else if (t == "string" or t == "char") { dflt = ""; }
        foreach (nm in n.names) { self.emit("PUSH", dflt, 0); self.emit("STORE", nm.lower(), 0); }
        return nil;
    }
    def visit_block(n) { foreach (d in n.decls) { d.accept(self); } n.compound.accept(self); return nil; }
    def visit_program(n) { n.block.accept(self); self.emit("HALT", 0, 0); return nil; }
}

// Compile Pascal source -> array of Instr (or nil on parse error).
def compile_pascal(src) {
    var p = Parser(src);
    var ast = p.parse_program();
    if (p.had_error) { print("PARSE ERROR: " + p.err_msg); return nil; }
    var g = CodeGen();
    ast.accept(g);
    return g.code;
}
