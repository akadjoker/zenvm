// Self-check for the Pascal lexer. Run: bin/zen examples/pascal/test_lexer.zen
include "lexer.zen";

var pass = 0; var fail = 0;
def eq(a, b, m) { if (a == b) { pass += 1; } else { fail += 1; print("FAIL " + m + " got=" + str(a) + " want=" + str(b)); } }

// Grab kinds as a parallel array, plus a comma-joined string (arrays compare
// by identity, so we assert on the joined string form).
def kinds(src) {
    var out = [];
    foreach (t in Lexer(src).tokenize()) { out.push(t.kind); }
    return out;
}
def kstr(src) {
    var out = "";
    foreach (t in Lexer(src).tokenize()) { out = out + t.kind + ","; }
    return out;
}
def texts(src) {
    var out = [];
    foreach (t in Lexer(src).tokenize()) { out.push(t.text); }
    return out;
}

// --- operators & punctuation ---
var k = kinds(":= <> <= >= .. + - * / = < > ( ) [ ] ; : , . ^ @");
eq(k[0], "ASSIGN", "assign"); eq(k[1], "NEQ", "neq"); eq(k[2], "LE", "le");
eq(k[3], "GE", "ge"); eq(k[4], "DOTDOT", "dotdot"); eq(k[5], "PLUS", "plus");
eq(k[19], "DOT", "dot"); eq(k[20], "CARET", "caret"); eq(k[21], "AT", "at");
eq(k[len(k) - 1], "EOF", "ends with EOF");

// --- numbers: int vs real, and the '..' must NOT eat the dot ---
eq(kstr("42"), "INT,EOF,", "int");
eq(kstr("3.14"), "REAL,EOF,", "real");
eq(kstr("1e10"), "REAL,EOF,", "real exponent");
eq(kstr("2.5e-3"), "REAL,EOF,", "real full");
eq(kstr("1..5"), "INT,DOTDOT,INT,EOF,", "range not a real");

// --- identifiers & case-insensitive keywords ---
eq(kstr("Begin END if Foo x1"), "KW_BEGIN,KW_END,KW_IF,ID,ID,EOF,", "keywords case-insensitive");
eq(texts("Begin")[0], "Begin", "keyword keeps original text");
eq(kstr("div mod and or not"), "KW_DIV,KW_MOD,KW_AND,KW_OR,KW_NOT,EOF,", "word operators");

// --- strings with escaped quotes ---
eq(texts("'hello'")[0], "hello", "simple string");
eq(texts("'it''s'")[0], "it's", "escaped quote");
eq(kstr("'a' 'b'"), "STR,STR,EOF,", "two strings");

// --- comments (all three styles) are skipped ---
eq(kstr('{ block } 1 (* nested? no *) 2 // line' + chr(10) + ' 3'),
   "INT,INT,INT,EOF,", "comments skipped");

// --- line tracking ---
var toks = Lexer("a\nb\n\nc").tokenize();
eq(toks[0].line, 1, "line 1"); eq(toks[1].line, 2, "line 2"); eq(toks[2].line, 4, "line 4");

// --- a whole tiny program tokenizes without ERROR tokens ---
var prog = "program Hi; var x: integer; begin x := 2 + 3 * 4; writeln(x) end.";
var pk = kinds(prog);
var had_err = false;
foreach (kk in pk) { if (kk == "ERROR") { had_err = true; } }
eq(had_err, false, "full program has no ERROR tokens");
eq(pk[0], "KW_PROGRAM", "program starts with KW_PROGRAM");
eq(pk[len(pk) - 2], "DOT", "program ends with '.'");

print("=== lexer: " + str(pass) + " passed, " + str(fail) + " failed ===");
