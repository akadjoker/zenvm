// Self-check for the bytecode CodeGen + StackVM.
// Strategy: for each program, the stack VM output MUST match the
// tree-walking interpreter output (the two visitors must agree),
// plus a few absolute-value checks.
// Run: bin/zen examples/pascal/test_stackvm.zen
include "interpreter.zen";
include "stackvm.zen";

var pass = 0; var fail = 0;
def nl() { return chr(10); }
def eq(a, b, m) { if (a == b) { pass += 1; } else { fail += 1; print("FAIL " + m); print("  got : " + str(a)); print("  want: " + str(b)); } }

// cross-check: stack VM output == interpreter output
def agree(src, m) {
    var vm = pas_exec(src);
    var it = Interpreter().run(src);
    if (vm == it) { pass += 1; } else {
        fail += 1; print("DISAGREE " + m);
        print("  stackvm    : " + str(vm));
        print("  interpreter: " + str(it));
    }
    return vm;
}

// --- absolute checks ---
eq(pas_exec("program t; begin writeln(2 + 3 * 4) end."), "14" + nl(), "precedence");
eq(pas_exec("program t; begin writeln(17 div 5, ' ', 17 mod 5) end."), "3 2" + nl(), "div/mod");
eq(pas_exec("program t; var i,s: integer; begin s:=0; for i:=1 to 10 do s:=s+i; writeln(s) end."),
   "55" + nl(), "for sum = 55");

// --- cross-checks against the interpreter ---
agree("program t; begin writeln((2+3)*4 - 1) end.", "arith");
agree("program t; var x: integer; begin x := 41; x := x + 1; writeln(x) end.", "assign");
agree("program t; var x: integer; begin x:=7; if x>5 then writeln('big') else writeln('small') end.", "if");
agree("program t; var i,s: integer; begin i:=1; s:=0; while i<=5 do begin s:=s+i; i:=i+1 end; writeln(s) end.", "while");
agree("program t; var i: integer; begin for i:=3 downto 1 do write(i) end.", "downto");
agree("program t; var i: integer; begin i:=0; repeat i:=i+1; write(i) until i>=4 end.", "repeat");
agree("program t; var n,f: integer; begin n:=5; f:=1; while n>1 do begin f:=f*n; n:=n-1 end; writeln(f) end.", "factorial");
agree("program t; var b: boolean; begin b:=(3>2) and not (1>5); if b then writeln('Y') else writeln('N') end.", "boolean");
agree("program t; begin writeln(10/4) end.", "real div");

// FizzBuzz 1..15 — the real cross-check workout
var FB = "program fb; var i: integer; begin" + nl() +
         "for i := 1 to 15 do" + nl() +
         "  if (i mod 3 = 0) and (i mod 5 = 0) then writeln('FizzBuzz')" + nl() +
         "  else if i mod 3 = 0 then writeln('Fizz')" + nl() +
         "  else if i mod 5 = 0 then writeln('Buzz')" + nl() +
         "  else writeln(i)" + nl() +
         "end.";
var fbout = agree(FB, "fizzbuzz 1..15");
eq(fbout.contains("FizzBuzz" + nl()), true, "fizzbuzz has FizzBuzz");
eq(fbout.contains("Fizz" + nl()), true, "fizzbuzz has Fizz");

// clock() native exists and returns a number (non-deterministic, type-check only).
// Parens matter: `clock()` is a Call (-> CALLN native); bare `clock` is a VarRef.
var ck = pas_exec("program t; var x: real; begin x := clock(); if x >= 0 then writeln('ok') else writeln('no') end.");
eq(ck, "ok" + nl(), "clock() native works");

print("=== stackvm: " + str(pass) + " passed, " + str(fail) + " failed ===");
