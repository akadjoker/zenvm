// ============================================================
// pascal / printer — a Visitor that walks the AST and renders it
// back to (canonical) Pascal source. Classic Visitor pattern:
// node.accept(printer) -> printer.visit_X(node). Recursion +
// polymorphic dispatch heavy on purpose.
// ============================================================
include "parser.zen";

// token-kind -> source symbol for operators
var OP_SYM = {
    "PLUS": "+", "MINUS": "-", "STAR": "*", "SLASH": "/",
    "EQ": "=", "NEQ": "<>", "LT": "<", "LE": "<=", "GT": ">", "GE": ">=",
    "KW_OR": "or", "KW_AND": "and", "KW_DIV": "div", "KW_MOD": "mod", "KW_NOT": "not"
};

class Printer {
    var level;
    def init() { self.level = 0; }
    def pad() { var s = ""; for (var i = 0; i < self.level; i += 1) { s = s + "  "; } return s; }

    // ---- expressions ----
    def visit_num(n)  { return n.text; }
    def visit_str(n)  { return "'" + n.value + "'"; }
    def visit_bool(n) { if (n.value) { return "true"; } return "false"; }
    def visit_varref(n) { return n.name; }
    def visit_binop(n) {
        return "(" + n.left.accept(self) + " " + OP_SYM[n.op] + " " + n.right.accept(self) + ")";
    }
    def visit_unary(n) {
        if (n.op == "KW_NOT") { return "(not " + n.operand.accept(self) + ")"; }
        return "(" + OP_SYM[n.op] + n.operand.accept(self) + ")";
    }
    def visit_call(n) {
        if (n.args.len() == 0) { return n.name; }
        var s = n.name + "(";
        for (var i = 0; i < n.args.len(); i += 1) {
            if (i > 0) { s = s + ", "; }
            s = s + n.args[i].accept(self);
        }
        return s + ")";
    }

    // ---- statements ----
    def visit_assign(n) { return n.name + " := " + n.expr.accept(self); }
    def visit_exprstmt(n) { return n.call.accept(self); }
    def visit_if(n) {
        var s = "if " + n.cond.accept(self) + " then\n";
        self.level += 1; s = s + self.pad() + n.then_s.accept(self); self.level -= 1;
        if (n.else_s != nil) {
            s = s + "\n" + self.pad() + "else\n";
            self.level += 1; s = s + self.pad() + n.else_s.accept(self); self.level -= 1;
        }
        return s;
    }
    def visit_while(n) {
        var s = "while " + n.cond.accept(self) + " do\n";
        self.level += 1; s = s + self.pad() + n.body.accept(self); self.level -= 1;
        return s;
    }
    def visit_for(n) {
        var dir = "to"; if (n.downto) { dir = "downto"; }
        var s = "for " + n.var_name + " := " + n.start.accept(self) + " " + dir + " " + n.stop.accept(self) + " do\n";
        self.level += 1; s = s + self.pad() + n.body.accept(self); self.level -= 1;
        return s;
    }
    def visit_repeat(n) {
        var s = "repeat\n";
        self.level += 1;
        for (var i = 0; i < n.body.len(); i += 1) {
            s = s + self.pad() + n.body[i].accept(self);
            if (i < n.body.len() - 1) { s = s + ";"; }
            s = s + "\n";
        }
        self.level -= 1;
        return s + self.pad() + "until " + n.cond.accept(self);
    }
    def visit_compound(n) {
        var s = "begin\n";
        self.level += 1;
        for (var i = 0; i < n.stmts.len(); i += 1) {
            s = s + self.pad() + n.stmts[i].accept(self);
            if (i < n.stmts.len() - 1) { s = s + ";"; }
            s = s + "\n";
        }
        self.level -= 1;
        return s + self.pad() + "end";
    }

    // ---- declarations / program ----
    def visit_vardecl(n) {
        var s = "";
        for (var i = 0; i < n.names.len(); i += 1) { if (i > 0) { s = s + ", "; } s = s + n.names[i]; }
        return s + ": " + n.type_name + ";";
    }
    def visit_block(n) {
        var s = "";
        if (n.decls.len() > 0) {
            s = s + "var\n";
            self.level += 1;
            foreach (d in n.decls) { s = s + self.pad() + d.accept(self) + "\n"; }
            self.level -= 1;
        }
        return s + n.compound.accept(self);
    }
    def visit_program(n) {
        return "program " + n.name + ";\n" + n.block.accept(self) + ".";
    }
}

def print_ast(node) { return node.accept(Printer()); }
