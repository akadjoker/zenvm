// ============================================================
// pascal / parser — recursive-descent parser producing the AST.
// Precedence climbing for expressions (relational < additive <
// multiplicative < unary < factor), matching Pascal. Deep
// recursion here is intentional VM stress.
// ============================================================
include "lexer.zen";
include "ast.zen";

class Parser {
    var toks;
    var pos;
    var had_error;
    var err_msg;

    def init(src) {
        self.toks = Lexer(src).tokenize();
        self.pos = 0;
        self.had_error = false;
        self.err_msg = "";
    }

    // ---- token cursor ----
    def peek() { return self.toks[self.pos]; }
    def kind() { return self.toks[self.pos].kind; }
    def check(k) { return self.kind() == k; }
    def advance() { var t = self.toks[self.pos]; if (self.kind() != "EOF") { self.pos += 1; } return t; }
    def match(k) { if (self.check(k)) { self.advance(); return true; } return false; }

    def error(msg) {
        if (self.had_error == false) {
            self.had_error = true;
            self.err_msg = msg + " (near '" + self.peek().text + "' on line " + str(self.peek().line) + ")";
        }
    }
    def expect(k, what) {
        if (self.check(k)) { return self.advance(); }
        self.error("expected " + what);
        return self.peek();
    }

    // ---- program / block / decls ----
    def parse_program() {
        self.expect("KW_PROGRAM", "'program'");
        var name = self.expect("ID", "program name").text;
        self.expect("SEMI", "';'");
        var block = self.parse_block();
        self.expect("DOT", "'.'");
        return Program(name, block);
    }

    def parse_block() {
        var decls = [];
        if (self.check("KW_VAR")) {
            self.advance();
            // one or more:  id {, id} : type ;
            while (self.check("ID")) {
                var names = [self.advance().text];
                while (self.match("COMMA")) { names.push(self.expect("ID", "identifier").text); }
                self.expect("COLON", "':'");
                var ty = self.parse_type();
                self.expect("SEMI", "';'");
                decls.push(VarDecl(names, ty));
            }
        }
        var comp = self.parse_compound();
        return Block(decls, comp);
    }

    def parse_type() {
        // simple named types only (integer/real/boolean/char/string or a user id)
        var t = self.peek();
        if (t.kind == "KW_INTEGER" or t.kind == "KW_REAL" or t.kind == "KW_BOOLEAN"
            or t.kind == "KW_CHAR" or t.kind == "KW_STRING" or t.kind == "ID") {
            return self.advance().text;
        }
        self.error("expected a type name");
        return "?";
    }

    // ---- statements ----
    def parse_compound() {
        self.expect("KW_BEGIN", "'begin'");
        var stmts = self.parse_stmt_list("KW_END");
        self.expect("KW_END", "'end'");
        return Compound(stmts);
    }

    // parse statements separated by ';' until `terminator` kind is seen.
    def parse_stmt_list(terminator) {
        var stmts = [];
        while (self.check(terminator) == false and self.check("EOF") == false) {
            var s = self.parse_statement();
            if (s != nil) { stmts.push(s); }
            if (self.match("SEMI") == false) { return stmts; }   // no ';' -> list done
        }
        return stmts;
    }

    def parse_statement() {
        var k = self.kind();
        if (k == "KW_BEGIN")  { return self.parse_compound(); }
        if (k == "KW_IF")     { return self.parse_if(); }
        if (k == "KW_WHILE")  { return self.parse_while(); }
        if (k == "KW_FOR")    { return self.parse_for(); }
        if (k == "KW_REPEAT") { return self.parse_repeat(); }
        if (k == "KW_WRITELN" or k == "KW_WRITE" or k == "KW_READ" or k == "KW_READLN") {
            return ExprStmt(self.parse_call(self.advance().text));
        }
        if (k == "ID") {
            var name = self.advance().text;
            if (self.check("ASSIGN")) {
                self.advance();
                return Assign(name, self.parse_expression());
            }
            // otherwise a procedure call statement
            return ExprStmt(self.parse_call(name));
        }
        // empty statement (e.g. a stray ';' before end)
        return nil;
    }

    def parse_if() {
        self.advance();                                  // 'if'
        var cond = self.parse_expression();
        self.expect("KW_THEN", "'then'");
        var then_s = self.parse_statement();
        var else_s = nil;
        if (self.match("KW_ELSE")) { else_s = self.parse_statement(); }
        return If(cond, then_s, else_s);
    }

    def parse_while() {
        self.advance();
        var cond = self.parse_expression();
        self.expect("KW_DO", "'do'");
        return While(cond, self.parse_statement());
    }

    def parse_for() {
        self.advance();
        var vn = self.expect("ID", "loop variable").text;
        self.expect("ASSIGN", "':='");
        var start = self.parse_expression();
        var down = false;
        if (self.match("KW_DOWNTO")) { down = true; } else { self.expect("KW_TO", "'to' or 'downto'"); }
        var stop = self.parse_expression();
        self.expect("KW_DO", "'do'");
        return For(vn, start, stop, down, self.parse_statement());
    }

    def parse_repeat() {
        self.advance();
        var body = self.parse_stmt_list("KW_UNTIL");
        self.expect("KW_UNTIL", "'until'");
        var cond = self.parse_expression();
        return Repeat(body, cond);
    }

    // call with an already-consumed name; parses optional (args)
    def parse_call(name) {
        var args = [];
        if (self.match("LPAREN")) {
            if (self.check("RPAREN") == false) {
                args.push(self.parse_expression());
                while (self.match("COMMA")) { args.push(self.parse_expression()); }
            }
            self.expect("RPAREN", "')'");
        }
        return Call(name, args);
    }

    // ---- expressions (precedence climbing) ----
    def is_rel(k)  { return k == "EQ" or k == "NEQ" or k == "LT" or k == "LE" or k == "GT" or k == "GE"; }
    def is_add(k)  { return k == "PLUS" or k == "MINUS" or k == "KW_OR"; }
    def is_mul(k)  { return k == "STAR" or k == "SLASH" or k == "KW_DIV" or k == "KW_MOD" or k == "KW_AND"; }

    def parse_expression() { return self.parse_rel(); }

    def parse_rel() {
        var left = self.parse_add();
        while (self.is_rel(self.kind())) {
            var op = self.advance().kind;
            left = BinOp(left, op, self.parse_add());
        }
        return left;
    }
    def parse_add() {
        var left = self.parse_mul();
        while (self.is_add(self.kind())) {
            var op = self.advance().kind;
            left = BinOp(left, op, self.parse_mul());
        }
        return left;
    }
    def parse_mul() {
        var left = self.parse_unary();
        while (self.is_mul(self.kind())) {
            var op = self.advance().kind;
            left = BinOp(left, op, self.parse_unary());
        }
        return left;
    }
    def parse_unary() {
        var k = self.kind();
        if (k == "KW_NOT" or k == "MINUS" or k == "PLUS") {
            var op = self.advance().kind;
            return UnaryOp(op, self.parse_unary());
        }
        return self.parse_factor();
    }
    def parse_factor() {
        var t = self.peek();
        if (t.kind == "INT")  { self.advance(); return NumLit(t.text, false); }
        if (t.kind == "REAL") { self.advance(); return NumLit(t.text, true); }
        if (t.kind == "STR")  { self.advance(); return StrLit(t.text); }
        if (t.kind == "KW_TRUE")  { self.advance(); return BoolLit(true); }
        if (t.kind == "KW_FALSE") { self.advance(); return BoolLit(false); }
        if (t.kind == "LPAREN") {
            self.advance();
            var e = self.parse_expression();
            self.expect("RPAREN", "')'");
            return e;
        }
        if (t.kind == "ID") {
            var name = self.advance().text;
            if (self.check("LPAREN")) { return self.parse_call(name); }   // function call
            return VarRef(name);
        }
        self.error("expected an expression");
        self.advance();                          // make progress to avoid a stall
        return NumLit("0", false);
    }
}
