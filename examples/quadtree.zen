// Point quadtree (broad-phase spatial index). Self-checking against brute force.
class AABB {
    var x=0; var y=0; var w=0; var h=0;
    def init(x,y,w,h){ self.x=x; self.y=y; self.w=w; self.h=h; }
    def contains(px,py){ return px>=self.x and px<self.x+self.w and py>=self.y and py<self.y+self.h; }
    def intersects(o){ return self.x < o.x+o.w and self.x+self.w > o.x and self.y < o.y+o.h and self.y+self.h > o.y; }
}
class Pt { var x; var y; var id; def init(x,y,id){ self.x=x; self.y=y; self.id=id; } }
class QuadTree {
    var b; var cap; var pts; var divided; var nw; var ne; var sw; var se;
    def init(b, cap){ self.b=b; self.cap=cap; self.pts=[]; self.divided=false;
                      self.nw=nil; self.ne=nil; self.sw=nil; self.se=nil; }
    def subdivide(){
        var x=self.b.x; var y=self.b.y; var hw=self.b.w/2; var hh=self.b.h/2;
        self.nw=QuadTree(AABB(x,y,hw,hh),self.cap);   self.ne=QuadTree(AABB(x+hw,y,hw,hh),self.cap);
        self.sw=QuadTree(AABB(x,y+hh,hw,hh),self.cap); self.se=QuadTree(AABB(x+hw,y+hh,hw,hh),self.cap);
        self.divided=true;
    }
    def insert(p){
        if (!self.b.contains(p.x,p.y)) { return false; }
        if (self.pts.len() < self.cap and !self.divided) { self.pts.push(p); return true; }
        if (!self.divided) { self.subdivide(); }
        if (self.nw.insert(p)) { return true; }  if (self.ne.insert(p)) { return true; }
        if (self.sw.insert(p)) { return true; }  if (self.se.insert(p)) { return true; }
        return false;
    }
    def query(range, found){
        if (!self.b.intersects(range)) { return; }
        foreach (p in self.pts) { if (range.contains(p.x,p.y)) { found.push(p); } }
        if (self.divided) { self.nw.query(range,found); self.ne.query(range,found);
                            self.sw.query(range,found); self.se.query(range,found); }
    }
}
var seed=12345;
def rnd(n){ seed=(seed*1103515245+12345)%2147483648; return seed%n; }
var qt=QuadTree(AABB(0,0,128,128),4); var pts=[];
foreach (i in 0..500){ var p=Pt(rnd(128),rnd(128),i); pts.push(p); qt.insert(p); }
var checks=0;
foreach (t in 0..20){
    var range=AABB(rnd(100),rnd(100),rnd(40)+5,rnd(40)+5);
    var got=[]; qt.query(range,got);
    var brute=0; foreach (p in pts){ if (range.contains(p.x,p.y)){ brute+=1; } }
    if (got.len()==brute){ checks+=1; } else { print("FAIL t="+t); }
}
if (checks==20){ print("=== quadtree OK (500 pts, 20 queries == brute force) ==="); }
