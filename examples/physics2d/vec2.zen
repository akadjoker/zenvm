// ============================================================
// physics2d / vec2 — 2D vector with operator overloading.
// Foundation for the physics engine. Self-checking.
// ============================================================

class Vec2 {
    var x = 0.0;
    var y = 0.0;
    def init(x, y) { self.x = x; self.y = y; }

    // operator overloads
    def __add__(o) { return Vec2(self.x + o.x, self.y + o.y); }
    def __sub__(o) { return Vec2(self.x - o.x, self.y - o.y); }
    def __mul__(s) { return Vec2(self.x * s, self.y * s); }   // scalar
    def __str__() { return "(" + self.x + ", " + self.y + ")"; }

    def dot(o) { return self.x * o.x + self.y * o.y; }
    def cross(o) { return self.x * o.y - self.y * o.x; }      // scalar (z of 3D cross)
    def len2() { return self.x * self.x + self.y * self.y; }
    def length() { return sqrt(self.len2()); }
    def scaled(s) { return Vec2(self.x * s, self.y * s); }
    def normalized() {
        var l = self.length();
        if (l < 0.00001) { return Vec2(0.0, 0.0); }
        return Vec2(self.x / l, self.y / l);
    }
    def perp() { return Vec2(-self.y, self.x); }              // 90° left
}

def approx(a, b) { return abs(a - b) < 0.0001; }
def eq(cond, m) { if (cond) { print("PASS " + m); } else { print("FAIL " + m); } }

var a = Vec2(3.0, 4.0);
var b = Vec2(1.0, 2.0);
eq(approx((a + b).x, 4.0) and approx((a + b).y, 6.0), "add");
eq(approx((a - b).x, 2.0) and approx((a - b).y, 2.0), "sub");
eq(approx((a * 2.0).x, 6.0) and approx((a * 2.0).y, 8.0), "scalar mul");
eq(approx(a.length(), 5.0), "len (3,4)=5");
eq(approx(a.dot(b), 11.0), "dot");
eq(approx(a.cross(b), 2.0), "cross");            // 3*2 - 4*1 = 2
eq(approx(a.normalized().length(), 1.0), "normalized is unit");
eq(approx(a.perp().dot(a), 0.0), "perp is orthogonal");
print("v =", a, " (via __str__)");
print("=== vec2 OK ===");
